<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TinkwellPackageGroup>SDK</TinkwellPackageGroup>
    <Description>OpenTelemetry helpers for Tinkwell components: shared meters, activities, and OTLP configuration.</Description>
    <PackageTags>$(PackageTags);telemetry opentelemetry otlp</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

</Project>
