# Generated by tw init (tinkwell-ensemble pack)

{% if topology == "balanced" %}
# ─── Balanced topology ────────────────────────────────────────────────
# gRPC services grouped in one runner, headless tasks in another.

runner grpc-services from "Tinkwell.Runner.Grpc.dll" {
    runlet store from "Tinkwell.Runlet.Store.dll" {
        storage = "{{ store_storage }}"
    }
{% if events %}
    runlet events from "Tinkwell.Runlet.Events.dll";
{% if event_persistence %}
    runlet event-persistence from "Tinkwell.Runlet.EventPersistence.dll" {
        db-path = "{{ event_persistence_path }}"
    }
{% endif %}
{% endif %}
{% if measures %}
    runlet measures from "Tinkwell.Runlet.Measures.dll";
{% if measure_events or route_measures_to_mqtt %}
    runlet measure-events from "Tinkwell.Runlet.MeasureEvents.dll";
{% endif %}
{% if signals %}
    runlet signals from "Tinkwell.Runlet.Signals.dll";
{% endif %}
{% if measure_history %}
    runlet measure-history from "Tinkwell.Runlet.MeasureHistory.dll" {
        backend = "{{ measure_history_backend }}"
        connection-string = "{{ measure_history_connection }}"
    }
{% endif %}
{% endif %}
}
{% if actions or route_measures_to_mqtt or route_events_to_mqtt or wallclock or statemachines or coap or mqtt or modbus or text_query or i2c or protobuf_gateway %}

runner background from "Tinkwell.Runner.Headless.dll" {
{% if actions or route_measures_to_mqtt or route_events_to_mqtt %}
    runlet actions from "Tinkwell.Runlet.Actions.dll";
{% endif %}
{% if wallclock or statemachines %}
    runlet wallclock from "Tinkwell.Runlet.Wallclock.dll";
{% endif %}
{% if statemachines %}
    runlet statemachines from "Tinkwell.Runlet.StateMachines.dll";
{% endif %}
{% if mqtt_embedded_broker %}
    runlet mqtt-server from "Tinkwell.Runlet.MqttServer.dll" {
        port = {{ mqtt_port }}
    }
{% endif %}
{% if mqtt %}
    runlet mqtt from "Tinkwell.Runlet.Mqtt.dll";
{% endif %}
{% if coap %}
    runlet coap from "Tinkwell.Runlet.Coap.dll";
{% endif %}
{% if modbus %}
    runlet modbus from "Tinkwell.Runlet.Modbus.dll";
{% endif %}
{% if text_query %}
    runlet text-query from "Tinkwell.Runlet.TextQuery.dll";
{% endif %}
{% if i2c %}
    runlet i2c from "Tinkwell.Runlet.I2c.dll";
{% endif %}
{% if protobuf_gateway %}
    runlet protobuf-gateway from "Tinkwell.Runlet.ProtobufGateway.dll" {
        port = {{ protobuf_gateway_port }}
    }
{% endif %}
}
{% endif %}
{% elsif topology == "reliable" %}
# ─── Reliable topology ───────────────────────────────────────────────
# Each core service in its own runner for fault isolation.

runner store-host from "Tinkwell.Runner.Grpc.dll" {
    runlet store from "Tinkwell.Runlet.Store.dll" {
        storage = "{{ store_storage }}"
    }
}
{% if events %}

runner events-host from "Tinkwell.Runner.Grpc.dll" {
    runlet events from "Tinkwell.Runlet.Events.dll";
{% if event_persistence %}
    runlet event-persistence from "Tinkwell.Runlet.EventPersistence.dll" {
        db-path = "{{ event_persistence_path }}"
    }
{% endif %}
}
{% endif %}
{% if measures %}

runner measures-host from "Tinkwell.Runner.Grpc.dll" {
    runlet measures from "Tinkwell.Runlet.Measures.dll";
{% if measure_events or route_measures_to_mqtt %}
    runlet measure-events from "Tinkwell.Runlet.MeasureEvents.dll";
{% endif %}
{% if signals %}
    runlet signals from "Tinkwell.Runlet.Signals.dll";
{% endif %}
{% if measure_history %}
    runlet measure-history from "Tinkwell.Runlet.MeasureHistory.dll" {
        backend = "{{ measure_history_backend }}"
        connection-string = "{{ measure_history_connection }}"
    }
{% endif %}
}
{% endif %}
{% if mqtt_embedded_broker or coap or modbus%}

runner servers from "Tinkwell.Runner.Headless.dll" {
    runlet mqtt-server from "Tinkwell.Runlet.MqttServer.dll" {
        port = {{ mqtt_port }}
    }
{% if coap %}
    runlet coap-server from "Tinkwell.Runlet.Coap.dll";
{% endif %}
}
{% endif %}
{% if actions or route_measures_to_mqtt or route_events_to_mqtt or wallclock or statemachines or mqtt or modbus or text_query or i2c or protobuf_gateway %}

    runner background from "Tinkwell.Runner.Headless.dll" {
{% if actions or route_measures_to_mqtt or route_events_to_mqtt %}
    runlet actions from "Tinkwell.Runlet.Actions.dll";
{% endif %}
{% if wallclock or statemachines %}
    runlet wallclock from "Tinkwell.Runlet.Wallclock.dll";
{% endif %}
{% if statemachines %}
    runlet statemachines from "Tinkwell.Runlet.StateMachines.dll";
{% endif %}

{% if mqtt %}
    runlet mqtt from "Tinkwell.Runlet.Mqtt.dll";
{% endif %}
{% if modbus %}
    runlet modbus from "Tinkwell.Runlet.Modbus.dll";
{% endif %}
{% if text_query %}
    runlet text-query from "Tinkwell.Runlet.TextQuery.dll";
{% endif %}
{% if i2c %}
    runlet i2c from "Tinkwell.Runlet.I2c.dll";
{% endif %}
{% if protobuf_gateway %}
    runlet protobuf-gateway from "Tinkwell.Runlet.ProtobufGateway.dll" {
        port = {{ protobuf_gateway_port }}
    }
{% endif %}
}
{% endif %}
{% elsif topology == "compact" %}
# ─── Compact topology ────────────────────────────────────────────────
# Everything in as few runners as possible.

runner main from "Tinkwell.Runner.Grpc.dll" {
    runlet store from "Tinkwell.Runlet.Store.dll" {
        storage = "{{ store_storage }}"
    }
{% if events %}
    runlet events from "Tinkwell.Runlet.Events.dll";
{% if event_persistence %}
    runlet event-persistence from "Tinkwell.Runlet.EventPersistence.dll" {
        db-path = "{{ event_persistence_path }}"
    }
{% endif %}
{% endif %}
{% if measures %}
    runlet measures from "Tinkwell.Runlet.Measures.dll";
{% if measure_events or route_measures_to_mqtt %}
    runlet measure-events from "Tinkwell.Runlet.MeasureEvents.dll";
{% endif %}
{% if signals %}
    runlet signals from "Tinkwell.Runlet.Signals.dll";
{% endif %}
{% if measure_history %}
    runlet measure-history from "Tinkwell.Runlet.MeasureHistory.dll" {
        backend = "{{ measure_history_backend }}"
        connection-string = "{{ measure_history_connection }}"
    }
{% endif %}
{% endif %}
{% if actions or route_measures_to_mqtt or route_events_to_mqtt %}
    runlet actions from "Tinkwell.Runlet.Actions.dll";
{% endif %}
{% if wallclock or statemachines %}
    runlet wallclock from "Tinkwell.Runlet.Wallclock.dll";
{% endif %}
{% if statemachines %}
    runlet statemachines from "Tinkwell.Runlet.StateMachines.dll";
{% endif %}
{% if mqtt_embedded_broker %}
    runlet mqtt-server from "Tinkwell.Runlet.MqttServer.dll" {
        port = {{ mqtt_port }}
    }
{% endif %}
{% if mqtt %}
    runlet mqtt from "Tinkwell.Runlet.Mqtt.dll";
{% endif %}
{% if coap %}
    runlet coap from "Tinkwell.Runlet.Coap.dll";
{% endif %}
{% if modbus %}
    runlet modbus from "Tinkwell.Runlet.Modbus.dll";
{% endif %}
{% if text_query %}
    runlet text-query from "Tinkwell.Runlet.TextQuery.dll";
{% endif %}
{% if i2c %}
    runlet i2c from "Tinkwell.Runlet.I2c.dll";
{% endif %}
{% if protobuf_gateway %}
    runlet protobuf-gateway from "Tinkwell.Runlet.ProtobufGateway.dll" {
        port = {{ protobuf_gateway_port }}
    }
{% endif %}
}
{% endif %}

{% if coap %}
# ─── CoAP ─────────────────────────────────────────────────────────────

coap sensors {
    port = {{ coap_port }}
{% for resource in coap_resources %}

    resource "{{ resource.path }}" {
        on post {
{% if resource.binding == "measure" %}
            bind measure {
                name = (segment(path, -1))
            }
{% endif %}
{% if resource.binding == "store" %}
            bind store {
                name = (segment(path, -1))
            }
{% endif %}
{% if resource.binding == "event" %}
            bind event {
                source = "coap"
                verb = changed
                name = (segment(path, -1))
                object = (payload)
            }
{% endif %}
        }
{% if resource.binding == "measure" %}
        on get {
            bind measure {
                name = (segment(path, -1))
            }
        }
{% endif %}
    }
{% endfor %}
{% if route_measures_to_coap %}

    resource "/measures/+" {
        on get {
            bind measure {
                name = (segment(path, -1))
            }
        }
    }
{% endif %}
}
{% endif %}

{% if mqtt %}
# ─── MQTT ─────────────────────────────────────────────────────────────

mqtt broker {
    broker = "{{ mqtt_broker }}"
    port = {{ mqtt_port }}

    subscribe "{{ mqtt_topic }}" {
        on message {
{% if mqtt_binding == "event" or mqtt_binding == "both" %}
            bind event {
                source = "mqtt"
                verb = changed
                name = (segment(topic, -1))
                object = (payload)
            }
{% endif %}
{% if mqtt_binding == "measure" or mqtt_binding == "both" %}
            bind measure {
                name = (segment(topic, -1))
            }
{% endif %}
        }
    }
}
{% endif %}

{% if modbus %}
# ─── Modbus ───────────────────────────────────────────────────────────

modbus devices {
{% if modbus_transport == "tcp" %}
    transport = tcp
    host = "{{ modbus_host }}"
    tcp-port = {{ modbus_tcp_port }}
{% elsif modbus_transport == "rtu" %}
    transport = rtu
    port = "{{ modbus_serial_port }}"
    baudrate = {{ modbus_baudrate }}
{% endif %}

    # TODO: add device and register blocks
    # device 1 {
    #     poll-interval = "1 second"
    #     register example {
    #         address = 0x0000
    #         type = float32-be
    #     }
    # }
}
{% endif %}

{% if route_measures_to_mqtt or route_events_to_mqtt %}
# ─── Data routing ─────────────────────────────────────────────────────
{% if route_measures_to_mqtt %}

action forward-measures-to-mqtt {
    source = measures
    verb = changed

    do mqtt-publish from "Tinkwell.Actions" {
        broker = "{{ mqtt_broker }}"
        topic = (format("{{ route_measures_mqtt_topic }}"))
        payload = (format("{Object}"))
    }
}
{% endif %}
{% if route_events_to_mqtt %}

action forward-events-to-mqtt {
    source = signals
    verb = fired

    do mqtt-publish from "Tinkwell.Actions" {
        broker = "{{ mqtt_broker }}"
        topic = (format("{{ route_events_mqtt_topic }}"))
        payload = (format("{Name}: {Object}"))
    }
}
{% endif %}
{% endif %}
