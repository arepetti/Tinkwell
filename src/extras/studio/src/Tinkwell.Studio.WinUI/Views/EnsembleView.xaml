<UserControl
    x:Class="Tinkwell.Studio.Views.EnsembleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:Tinkwell.Studio.ViewModels">

    <UserControl.Resources>
        <!-- Recursive block template. The inner ItemsControl binds to Children
             and references this same template by key, so nesting is unbounded.
             WinUI, like Avalonia, resolves StaticResource references to later
             items in the same dictionary at runtime, which is what makes the
             self-reference work. -->
        <DataTemplate x:Key="EnsembleBlockTemplate" x:DataType="vm:EnsembleBlockNode">
            <Border Margin="0,4"
                    CornerRadius="{ThemeResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- Left accent stripe: fills vertically, colored per block type. -->
                    <Rectangle Grid.Column="0"
                               Fill="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}" />
                    <StackPanel Grid.Column="1">
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Expand / collapse chevron. Two FontIcons behind
                                 visibility switches rather than a rotation so the
                                 accessibility tree stays simple. -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource IconButtonStyle}"
                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Command="{Binding ToggleExpandCommand}"
                                    ToolTipService.ToolTip="Expand / collapse"
                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                <Grid>
                                    <FontIcon Glyph="&#xE76C;" FontSize="14"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="14"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                            <!-- Placeholder keeps the type chip and title
                                 column-aligned whether the block has children
                                 or not. -->
                            <Border Grid.Column="0" Width="28"
                                    Visibility="{Binding HasChildren, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                            <Button Grid.Column="1"
                                    Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="8,6,12,6"
                                    Command="{Binding SelectBlockCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTipService.ToolTip="Show modifiers and properties">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{Binding AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                            CornerRadius="{ThemeResource ControlCornerRadius}"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Type}"
                                                   Foreground="White"
                                                   FontWeight="SemiBold"
                                                   FontSize="11" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </Button>
                        </Grid>

                        <!-- Children: recursive reference to this same template. -->
                        <ItemsControl ItemsSource="{Binding Children}"
                                      ItemTemplate="{StaticResource EnsembleBlockTemplate}"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                      Margin="20,0,8,10" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <muxc:SplitView IsPaneOpen="{Binding IsDrawerOpen}"
                    PanePlacement="Right"
                    DisplayMode="Inline"
                    OpenPaneLength="560"
                    CompactPaneLength="0">

        <muxc:SplitView.Pane>
            <Border Style="{StaticResource DrawerPanelStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Background="{Binding Selected.AccentColorHex, Converter={StaticResource HexToBrushConverter}}"
                                CornerRadius="{ThemeResource ControlCornerRadius}"
                                Padding="6,2"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selected.Type}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Selected.Title}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CloseDrawerCommand}"
                                ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="4"
                                        Visibility="{Binding Selected.HasModifiers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Modifiers"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding Selected.Modifiers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EnsembleDetailItem">
                                            <Grid Margin="0,3" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Spacing="4"
                                        Visibility="{Binding Selected.HasProperties, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Properties"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding Selected.Properties}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EnsembleDetailItem">
                                            <Grid Margin="0,3" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="NoWrap" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                           FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </muxc:SplitView.Pane>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <ProgressRing Style="{StaticResource InlineBusyRingStyle}"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Blocks.Count}" VerticalAlignment="Center" />
                    <TextBlock Text="top-level block(s)" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding SourcePath}" VerticalAlignment="Center"
                               Foreground="{Binding SourcePath, Converter={StaticResource UrlToBrushConverter}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="600" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="16,12,20,20"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Blocks}"
                              ItemTemplate="{StaticResource EnsembleBlockTemplate}" />
            </ScrollViewer>
        </Grid>
    </muxc:SplitView>
</UserControl>
