<UserControl
    x:Class="Tinkwell.Studio.Views.MeasuresView"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:svc="using:Tinkwell.Studio.Services"
    xmlns:vm="using:Tinkwell.Studio.ViewModels"
    xmlns:controls="using:Tinkwell.Studio.Controls">

    <!-- Outer Grid only because we need to overlay the Set-value modal on
         top of the WorkspacePage; without it the SplitView would clip. -->
    <Grid>
        <controls:WorkspacePage IsDrawerOpen="{Binding IsDrawerOpen}"
                                DrawerWidth="420"
                                DrawerTitle="{Binding Selected.Name}"
                                CloseDrawerCommand="{Binding CloseDrawerCommand}">

            <controls:WorkspacePage.Detail>
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenSetCommand}"
                            ToolTipService.ToolTip="Set value">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="Edit" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Selected.Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="svc:Detail">
                                <Grid Margin="0,3" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}"
                                               FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                               Foreground="{Binding ., Converter={StaticResource DetailForegroundConverter}}"
                                               FontFamily="{Binding ., Converter={StaticResource DetailFontFamilyConverter}}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="2" Text="Change log"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,8,0,4" />
                    <ListView Grid.Row="3" ItemsSource="{Binding Selected.ChangeLog}"
                              FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                              SelectionMode="None" />
                </Grid>
            </controls:WorkspacePage.Detail>

            <controls:WorkspacePage.Toolbar>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <ProgressRing Style="{StaticResource InlineBusyRingStyle}"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Measures.Count}" VerticalAlignment="Center" />
                    <TextBlock Text="measures" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </controls:WorkspacePage.Toolbar>

            <controls:WorkspacePage.List>
                <!-- One Expander per category. WinUI.TableView 1.4.1 doesn't
                     support grouping internally, so we render a separate
                     TableView per group inside an outer ItemsControl. Every
                     TableView TwoWay-binds SelectedItem to the same VM
                     property: WinUI clears the visual selection on the
                     other tables automatically when the bound value isn't
                     part of their items source. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MeasureGroup">
                                <Expander HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="True"
                                          Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Category}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="(" />
                                                <Run Text="{Binding Measures.Count}" />
                                                <Run Text=")" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Expander.Header>
                                    <!-- Selection is wired up in code-behind: each
                                         inner table pushes its choice to the VM
                                         via a SelectionChanged handler that also
                                         clears the visual selection on the
                                         sibling tables. A naive TwoWay binding
                                         on SelectedItem causes the other tables
                                         to round-trip the new value back to null
                                         (it isn't in their items source), which
                                         immediately closes the drawer. -->
                                    <tv:TableView ItemsSource="{Binding Measures}"
                                                  SelectionUnit="Row"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal"
                                                  Loaded="OnInnerTableLoaded"
                                                  Unloaded="OnInnerTableUnloaded">
                                        <tv:TableView.Columns>
                                            <!-- Kind indicator: a small "avatar" chip
                                                 whose tone encodes the measure kind
                                                 (default = normal, muted = constant
                                                 or system, accent = calculated). -->
                                            <tv:TableViewTemplateColumn Header="" Width="44">
                                                <tv:TableViewTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:MeasureEntry">
                                                        <controls:Indicator Tone="{Binding Tone}"
                                                                            Glyph="{Binding Kind, Converter={StaticResource MeasureKindToGlyphConverter}}"
                                                                            Margin="12,0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            ToolTipService.ToolTip="{Binding Kind, Converter={StaticResource MeasureKindToLabelConverter}}" />
                                                    </DataTemplate>
                                                </tv:TableViewTemplateColumn.CellTemplate>
                                            </tv:TableViewTemplateColumn>
                                            <tv:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <!-- Value column: numeric text + an
                                                 inline ProgressBar showing where the
                                                 current value sits between the
                                                 measure's configured min and max.
                                                 The bar is hidden (collapsed) for
                                                 measures without a usable range or
                                                 with a non-numeric value — the text
                                                 then fills the cell. Same visual
                                                 pattern as the home view's CPU /
                                                 memory bars. -->
                                            <tv:TableViewTemplateColumn Header="Value" Width="220">
                                                <tv:TableViewTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:MeasureEntry">
                                                        <Grid Margin="12,0" ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Value}"
                                                                       VerticalAlignment="Center" />
                                                            <ProgressBar Grid.Column="1"
                                                                         Minimum="{Binding MinNumeric}"
                                                                         Maximum="{Binding MaxNumeric}"
                                                                         Value="{Binding ValueNumeric}"
                                                                         Height="6"
                                                                         VerticalAlignment="Center"
                                                                         IsHitTestVisible="False"
                                                                         Visibility="{Binding HasRangeBar, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </tv:TableViewTemplateColumn.CellTemplate>
                                            </tv:TableViewTemplateColumn>
                                            <tv:TableViewTextColumn Header="Unit" Binding="{Binding Unit}" Width="100" />
                                            <tv:TableViewTextColumn Header="Min" Binding="{Binding Min}" Width="90" />
                                            <tv:TableViewTextColumn Header="Max" Binding="{Binding Max}" Width="90" />
                                        </tv:TableView.Columns>
                                    </tv:TableView>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </controls:WorkspacePage.List>
        </controls:WorkspacePage>

        <!-- Modal overlay: WinUI has ContentDialog for this, but the current
             UX (a single dialog surface per view, driven by an IsOpen bool on
             the VM) maps cleanly to an overlay pattern and keeps the view
             fully declarative. -->
        <Border Visibility="{Binding IsSetOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="560" MaxWidth="640"
                    Padding="24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Selected.Name}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox PlaceholderText="value" Text="{Binding SetValue, Mode=TwoWay}" MinHeight="36" />
                    <TextBlock Text="{Binding SetError}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding SetError, Converter={StaticResource StringToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseSetCommand}" />
                        <Button Content="Apply" Style="{ThemeResource AccentButtonStyle}" Command="{Binding SubmitSetCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
