<UserControl
    x:Class="Tinkwell.Studio.Views.CoapView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:svc="using:Tinkwell.Studio.Services"
    xmlns:vm="using:Tinkwell.Studio.ViewModels">

    <Grid>
        <muxc:SplitView IsPaneOpen="{Binding IsDrawerOpen}"
                        PanePlacement="Right"
                        DisplayMode="Inline"
                        OpenPaneLength="460"
                        CompactPaneLength="0">
            <muxc:SplitView.Pane>
                <Border Style="{StaticResource DrawerPanelStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Response"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding CloseDrawerCommand}"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Selected.Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:Detail">
                                    <Grid Margin="0,3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Foreground="{Binding ., Converter={StaticResource DetailForegroundConverter}}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Text="Body"
                                   FontWeight="SemiBold" Margin="0,8,0,4"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox Grid.Row="3"
                                 Text="{Binding Selected.Body, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Code, Consolas, Menlo, monospace" />
                    </Grid>
                </Border>
            </muxc:SplitView.Pane>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar is now actions-only; the request builder (method,
                     path, host, port, payload, etc.) lives in the Settings
                     dialog and the values persist on the VM so Send can be
                     fired repeatedly without re-entering them. -->
                <Border Grid.Row="0" Padding="12"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding SendCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                ToolTipService.ToolTip="Send request">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE724;" FontSize="14" />
                                <TextBlock Text="Send" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenSettingsCommand}" ToolTipService.ToolTip="Edit request">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE713;" FontSize="14" />
                                <TextBlock Text="Settings..." VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ClearHistoryCommand}"
                                ToolTipService.ToolTip="Clear history">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                <TextBlock Text="Clear history" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressRing Style="{StaticResource InlineBusyRingStyle}"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="Sending..." VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <!-- Compact preview of the current target so the user can
                             see what Send will hit without reopening the dialog. -->
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   FontFamily="Cascadia Code, Consolas, Menlo, monospace">
                            <Run Text="{Binding Method}" />
                            <Run Text=" " />
                            <Run Text="{Binding Host}" />
                            <Run Text=":" />
                            <Run Text="{Binding Port}" />
                            <Run Text="{Binding Path}" />
                        </TextBlock>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <tv:TableView Grid.Row="1"
                               ItemsSource="{Binding History}"
                               SelectedItem="{Binding Selected, Mode=TwoWay}"
                               SelectionUnit="Row"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               GridLinesVisibility="Horizontal">
                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn Header="Time" Binding="{Binding TimestampText}" Width="90" />
                        <tv:TableViewTextColumn Header="Method" Binding="{Binding Method}" Width="80" />
                        <tv:TableViewTextColumn Header="Target" Binding="{Binding Target}" Width="*" />
                        <tv:TableViewTemplateColumn Header="Status" Width="140">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:CoapHistoryEntry">
                                    <TextBlock Text="{Binding Status}" Margin="12,0" VerticalAlignment="Center"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                    </tv:TableView.Columns>
                </tv:TableView>
            </Grid>
        </muxc:SplitView>

        <!-- Request builder overlay: two-way binds directly to the VM's
             observable properties, so values are remembered as long as the
             VM lives (i.e. across open/close cycles and category switches). -->
        <Border Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="640" MaxWidth="780" Padding="24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock Text="CoAP request" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Method" VerticalAlignment="Center" />
                        <ComboBox  Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Methods}"
                                   SelectedItem="{Binding Method, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Timeout (s)" VerticalAlignment="Center" />
                        <muxc:NumberBox Grid.Row="0" Grid.Column="3" Value="{Binding TimeoutSeconds, Mode=TwoWay}"
                                        Minimum="1" Maximum="120" HorizontalAlignment="Left" Width="160" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Host" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Host, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Port" VerticalAlignment="Center" />
                        <muxc:NumberBox Grid.Row="1" Grid.Column="3" Value="{Binding Port, Mode=TwoWay}"
                                        Minimum="1" Maximum="65535" HorizontalAlignment="Left" Width="160" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Path" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Path, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Accept" VerticalAlignment="Center" />
                        <ComboBox  Grid.Row="2" Grid.Column="3" ItemsSource="{Binding AcceptOptions}"
                                   SelectedItem="{Binding Accept, Mode=TwoWay}" HorizontalAlignment="Stretch" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Payload" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <TextBox  Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding PayloadText, Mode=TwoWay}"
                                  AcceptsReturn="True" MinHeight="120"
                                  FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                  PlaceholderText="Optional payload for POST/PUT" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Close" Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding CloseSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
