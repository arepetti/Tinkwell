<UserControl
    x:Class="Tinkwell.Studio.Views.RunnersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:svc="using:Tinkwell.Studio.Services"
    xmlns:vm="using:Tinkwell.Studio.ViewModels"
    xmlns:controls="using:Tinkwell.Studio.Controls">

    <controls:WorkspacePage IsDrawerOpen="{Binding IsDrawerOpen}"
                            DrawerWidth="420"
                            DrawerTitle="{Binding Selected.Name}"
                            CloseDrawerCommand="{Binding CloseDrawerCommand}">

        <!-- Drawer body: structured property list rendered from VM details. -->
        <controls:WorkspacePage.Detail>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Selected.Details}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:Detail">
                            <Grid Margin="0,3" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}"
                                           Foreground="{Binding ., Converter={StaticResource DetailForegroundConverter}}"
                                           FontFamily="{Binding ., Converter={StaticResource DetailFontFamilyConverter}}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </controls:WorkspacePage.Detail>

        <!-- Toolbar: refresh + busy indicator + error message. -->
        <controls:WorkspacePage.Toolbar>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <ProgressRing Style="{StaticResource InlineBusyRingStyle}"
                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="Loading..." VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </controls:WorkspacePage.Toolbar>

        <!-- SelectionUnit="Row" so clicking anywhere in a row drives
             SelectedItem; the default (CellOrRow) only updates the selected
             cell, leaving the bound view-model unchanged and the drawer
             closed. -->
        <controls:WorkspacePage.List>
            <tv:TableView ItemsSource="{Binding Runners}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          SelectionUnit="Row"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal">
                <tv:TableView.Columns>
                    <!-- Status chip: green when the runner is healthy and
                         running, amber while it's starting / restarting /
                         degraded, red when it's stopped or unhealthy. The
                         row's text columns still spell out status / health
                         so the chip is a quick at-a-glance summary, not the
                         only signal. The tooltip uses the runner's status
                         keyword to keep the chip self-describing. -->
                    <tv:TableViewTemplateColumn Header="" Width="44">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:RunnerRow">
                                <controls:Indicator Tone="{Binding Tone}"
                                                    Margin="12,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="{Binding Status}" />
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    <tv:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <tv:TableViewTextColumn Header="Id" Binding="{Binding Id}" Width="160" />
                    <tv:TableViewTemplateColumn Header="Status" Width="120">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:RunnerRow">
                                <TextBlock Text="{Binding Status}" Margin="12,0" VerticalAlignment="Center"
                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    <tv:TableViewTextColumn Header="PID" Binding="{Binding Pid}" Width="80" />
                    <tv:TableViewTemplateColumn Header="Endpoint" Width="200">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:RunnerRow">
                                <TextBlock Text="{Binding Endpoint}" Margin="12,0" VerticalAlignment="Center"
                                           Foreground="{Binding Endpoint, Converter={StaticResource UrlToBrushConverter}}" />
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    <tv:TableViewTemplateColumn Header="Health" Width="120">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:RunnerRow">
                                <TextBlock Text="{Binding HealthStatus}" Margin="12,0" VerticalAlignment="Center"
                                           Foreground="{Binding HealthStatus, Converter={StaticResource StatusToBrushConverter}}" />
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                </tv:TableView.Columns>
            </tv:TableView>
        </controls:WorkspacePage.List>
    </controls:WorkspacePage>
</UserControl>
