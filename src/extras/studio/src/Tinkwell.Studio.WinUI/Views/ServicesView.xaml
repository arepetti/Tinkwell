<UserControl
    x:Class="Tinkwell.Studio.Views.ServicesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    xmlns:svc="using:Tinkwell.Studio.Services"
    xmlns:vm="using:Tinkwell.Studio.ViewModels"
    xmlns:controls="using:Tinkwell.Studio.Controls"
    mc:Ignorable="d">

    <controls:WorkspacePage IsDrawerOpen="{Binding IsDrawerOpen}"
                            DrawerWidth="460"
                            CloseDrawerCommand="{Binding CloseDrawerCommand}">

        <!-- Custom drawer header: friendly name in the title style + the
             technical name underneath in monospace, since this view shows
             both. The default DrawerTitle slot only fits a single line. -->
        <controls:WorkspacePage.DrawerHeader>
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Selected.FriendlyName}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Visibility="{Binding Selected.FriendlyName, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Text="{Binding Selected.Name}"
                           FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </controls:WorkspacePage.DrawerHeader>

        <controls:WorkspacePage.Detail>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Selected.Details}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:Detail">
                            <Grid Margin="0,3" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="NoWrap" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Foreground="{Binding ., Converter={StaticResource DetailForegroundConverter}}"
                                           FontFamily="{Binding ., Converter={StaticResource DetailFontFamilyConverter}}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </controls:WorkspacePage.Detail>

        <controls:WorkspacePage.Toolbar>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource IconButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
                <ProgressRing Style="{StaticResource InlineBusyRingStyle}"
                              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                <TextBlock Text="{Binding Services.Count}"
                           VerticalAlignment="Center" />
                <TextBlock Text="service(s)"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </controls:WorkspacePage.Toolbar>

        <controls:WorkspacePage.List>
            <tv:TableView ItemsSource="{Binding Services}"
                          SelectedItem="{Binding Selected, Mode=TwoWay}"
                          SelectionUnit="Row"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal">
                <tv:TableView.Columns>
                    <!-- Default leading chip: services don't expose a per-row
                         classification (every row is just a registered service)
                         so every row gets the same neutral indicator. The
                         chip is here for visual consistency with Runners /
                         Measures / Events / Store. -->
                    <tv:TableViewTemplateColumn Header="" Width="44">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ServiceRow">
                                <controls:Indicator Margin="12,0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                    <tv:TableViewTextColumn Header="Friendly Name" Binding="{Binding FriendlyName}" Width="220" />
                    <tv:TableViewTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <tv:TableViewTextColumn Header="Family name" Binding="{Binding FamilyName}" Width="140" />
                    <tv:TableViewTemplateColumn Header="Host" Width="180">
                        <tv:TableViewTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:ServiceRow">
                                <TextBlock Text="{Binding Host}"
                                           Margin="12,0"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Host, Converter={StaticResource UrlToBrushConverter}}" />
                            </DataTemplate>
                        </tv:TableViewTemplateColumn.CellTemplate>
                    </tv:TableViewTemplateColumn>
                </tv:TableView.Columns>
            </tv:TableView>
        </controls:WorkspacePage.List>
    </controls:WorkspacePage>
</UserControl>
