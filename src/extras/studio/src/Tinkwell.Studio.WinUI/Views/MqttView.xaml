<UserControl
    x:Class="Tinkwell.Studio.Views.MqttView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:svc="using:Tinkwell.Studio.Services"
    xmlns:vm="using:Tinkwell.Studio.ViewModels">

    <Grid>
        <muxc:SplitView IsPaneOpen="{Binding IsDrawerOpen}"
                        PanePlacement="Right"
                        DisplayMode="Inline"
                        OpenPaneLength="460"
                        CompactPaneLength="0">
            <muxc:SplitView.Pane>
                <Border Style="{StaticResource DrawerPanelStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Message details"
                                       Style="{StaticResource SubtitleTextBlockStyle}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding CloseDrawerCommand}"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedMessage.Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:Detail">
                                    <Grid Margin="0,3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Foreground="{Binding ., Converter={StaticResource DetailForegroundConverter}}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Grid.Row="2" Text="Payload"
                                   FontWeight="SemiBold" Margin="0,8,0,4"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBox Grid.Row="3"
                                 Text="{Binding SelectedMessage.PayloadText, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Code, Consolas, Menlo, monospace" />
                    </Grid>
                </Border>
            </muxc:SplitView.Pane>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <!-- Toolbar is just actions now; broker host / port / credentials
                         live in the Connection settings dialog (opened from here)
                         and persist on the view model so the user can re-open and
                         re-send without re-typing. -->
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding OpenSettingsCommand}" ToolTipService.ToolTip="Connection settings">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                                    <TextBlock Text="Settings..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{ThemeResource AccentButtonStyle}"
                                    Command="{Binding ConnectCommand}"
                                    IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                    <TextBlock Text="Connect" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DisconnectCommand}"
                                    IsEnabled="{Binding IsConnected}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE71D;" FontSize="14" />
                                    <TextBlock Text="Disconnect" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PingCommand}" ToolTipService.ToolTip="Ping broker">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9F9;" FontSize="14" />
                                    <TextBlock Text="Ping" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenPublishCommand}" ToolTipService.ToolTip="Publish message">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                                    <TextBlock Text="Publish..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ClearCommand}" ToolTipService.ToolTip="Clear messages">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="Clear" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding ConnectionStatus}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding NewTopic, Mode=TwoWay}" Width="260"
                                     PlaceholderText="topic filter (e.g. sensors/#)" />
                            <Button Command="{Binding AddSubscriptionCommand}"
                                    IsEnabled="{Binding IsConnected}"
                                    ToolTipService.ToolTip="Subscribe to topic">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock Text="Subscribe" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- Subscribed topics chips. Horizontal flow so they line up with the input box. -->
                            <ItemsControl x:Name="SubsList" ItemsSource="{Binding Subscriptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Padding="8,3" CornerRadius="10"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource IconButtonStyle}"
                                                        Padding="4,0"
                                                        ToolTipService.ToolTip="Unsubscribe"
                                                        Command="{Binding ElementName=SubsList, Path=DataContext.RemoveSubscriptionCommand}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <tv:TableView Grid.Row="1"
                               ItemsSource="{Binding Messages}"
                               SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                               SelectionUnit="Row"
                               AutoGenerateColumns="False"
                               IsReadOnly="True"
                               GridLinesVisibility="Horizontal">
                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn Header="Time" Binding="{Binding Timestamp}" Width="140" />
                        <tv:TableViewTextColumn Header="Topic" Binding="{Binding Topic}" Width="*" />
                        <tv:TableViewTextColumn Header="QoS" Binding="{Binding Qos}" Width="60" />
                        <tv:TableViewTextColumn Header="Payload" Binding="{Binding PayloadText}" Width="2*" />
                    </tv:TableView.Columns>
                </tv:TableView>
            </Grid>
        </muxc:SplitView>

        <Border Visibility="{Binding IsPublishOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="680" MaxWidth="820" Padding="24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Publish MQTT message" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox PlaceholderText="topic" Text="{Binding PublishTopic, Mode=TwoWay}" MinHeight="36" />
                    <TextBox PlaceholderText="payload" Text="{Binding PublishPayload, Mode=TwoWay}"
                             AcceptsReturn="True" MinHeight="220"
                             FontFamily="Cascadia Code, Consolas, Menlo, monospace" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="QoS:" VerticalAlignment="Center" />
                        <muxc:NumberBox Value="{Binding PublishQos, Mode=TwoWay}" Minimum="0" Maximum="2" Width="110" />
                        <CheckBox Content="Retain" IsChecked="{Binding PublishRetain, Mode=TwoWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PublishError}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding PublishError, Converter={StaticResource StringToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding ClosePublishCommand}" />
                        <Button Content="Publish" Style="{ThemeResource AccentButtonStyle}" Command="{Binding SubmitPublishCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Connection settings overlay: two-way binds directly to the VM's
             observable properties, so the values live as long as the view
             model itself (i.e. across open/close cycles and category switches). -->
        <Border Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="520" MaxWidth="640" Padding="24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock Text="MQTT broker settings" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Grid ColumnSpacing="8" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding BrokerHost, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" VerticalAlignment="Center" />
                        <muxc:NumberBox Grid.Row="1" Grid.Column="1" Value="{Binding BrokerPort, Mode=TwoWay}"
                                        Minimum="1" Maximum="65535" HorizontalAlignment="Left" Width="160" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Client id" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding ClientId, Mode=TwoWay}" PlaceholderText="(auto)" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="User" VerticalAlignment="Center" />
                        <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Username, Mode=TwoWay}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Password" VerticalAlignment="Center" />
                        <PasswordBox Grid.Row="4" Grid.Column="1" Password="{Binding Password, Mode=TwoWay}" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Close" Style="{ThemeResource AccentButtonStyle}"
                                Command="{Binding CloseSettingsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
