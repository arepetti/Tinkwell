<UserControl
    x:Class="Tinkwell.Studio.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:svc="using:Tinkwell.Studio.Services"
    xmlns:vm="using:Tinkwell.Studio.ViewModels">

    <muxc:SplitView IsPaneOpen="{Binding IsDrawerOpen}"
                    PanePlacement="Right"
                    DisplayMode="Inline"
                    OpenPaneLength="560"
                    CompactPaneLength="0">
        <muxc:SplitView.Pane>
            <Border Style="{StaticResource DrawerPanelStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Raw data"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                        <Button Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding CloseDrawerCommand}"
                                ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                    <muxc:TabView Grid.Row="1"
                                  IsAddTabButtonVisible="False"
                                  CanDragTabs="False"
                                  CanReorderTabs="False"
                                  TabWidthMode="SizeToContent">
                        <muxc:TabView.TabItems>
                            <muxc:TabViewItem Header="tw status" IsClosable="False">
                                <TextBox Text="{Binding RawStatusJson, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                         AcceptsReturn="True" TextWrapping="NoWrap" />
                            </muxc:TabViewItem>
                            <muxc:TabViewItem Header="tw info" IsClosable="False">
                                <TextBox Text="{Binding RawInfoJson, Mode=OneWay}" IsReadOnly="True"
                                         FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                         AcceptsReturn="True" TextWrapping="NoWrap" />
                            </muxc:TabViewItem>
                        </muxc:TabView.TabItems>
                    </muxc:TabView>
                </Grid>
            </Border>
        </muxc:SplitView.Pane>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="12"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button Command="{Binding ShowRawCommand}" ToolTipService.ToolTip="Show raw data">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE946;" FontSize="14" />
                            <TextBlock Text="Show raw..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ProgressRing Style="{StaticResource InlineBusyRingStyle}"
                                  Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="Loading..." VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding LastRefreshedText}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Padding="16,16,20,24"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <!-- Two rows of four KPI cards. Grid with Auto/Uniform columns
                         rather than UniformGrid (which doesn't ship with core
                         WinUI). -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Product" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ProductName}"
                                           FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ProductVersion}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Coordinator" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding CoordinatorStateText}"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{Binding CoordinatorStateText, Converter={StaticResource StatusToBrushConverter}}" />
                                <TextBlock Text="{Binding PingLatencyText}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Runners" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding RunnerCount}"
                                           FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RunnerBreakdown}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Healthy" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding HealthySummary}"
                                           FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="runners passing health check"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Services" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding ServiceCount}"
                                           FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="registered endpoints" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Measures" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding MeasureCount}"
                                           FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="registered measures" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Store" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding StoreCount}"
                                           FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="entries across buckets" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <!-- Empty slot keeps row rhythm consistent. -->
                        <Grid Grid.Column="3" />
                    </Grid>

                    <!-- Status breakdown: chips + a proportional stacked bar.
                         Viewbox Stretch="Fill" scales the inner StackPanel (whose
                         children have width=count) horizontally to fill the row. -->
                    <Border Style="{StaticResource DashboardCardStyle}"
                            Visibility="{Binding StatusBreakdown.Count, Converter={StaticResource CountToVisibilityConverter}}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Runner status" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl ItemsSource="{Binding StatusBreakdown}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatusSlice">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="10" Height="10"
                                                     Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Count}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Height="12" CornerRadius="6"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Viewbox Stretch="Fill">
                                    <ItemsControl ItemsSource="{Binding StatusBreakdown}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StatusSlice">
                                                <Rectangle Height="12" Width="{Binding Count}"
                                                           Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Resource usage table: CPU + Memory as inline bars.
                         Memory bar bound to MaxMemoryBytes on each row so every
                         bar is scaled to the busiest runner in the snapshot. -->
                    <Border Style="{StaticResource DashboardCardStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Resource usage"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="sorted by CPU, bars scaled to busiest runner"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <tv:TableView Grid.Row="1"
                                           ItemsSource="{Binding Resources}"
                                           AutoGenerateColumns="False"
                                           IsReadOnly="True"
                                           
                                           GridLinesVisibility="Horizontal"
                                           MaxHeight="360">
                                <tv:TableView.Columns>
                                    <tv:TableViewTextColumn Header="Runner" Binding="{Binding Name}" Width="*" />
                                    <tv:TableViewTemplateColumn Header="Health" Width="120">
                                        <tv:TableViewTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:ResourceRow">
                                                <TextBlock Text="{Binding Status}" Margin="12,0" VerticalAlignment="Center"
                                                           Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}}" />
                                            </DataTemplate>
                                        </tv:TableViewTemplateColumn.CellTemplate>
                                    </tv:TableViewTemplateColumn>
                                    <tv:TableViewTemplateColumn Header="CPU" Width="2*">
                                        <tv:TableViewTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:ResourceRow">
                                                <Grid Margin="8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100"
                                                                 Value="{Binding CpuPercent}"
                                                                 VerticalAlignment="Center" Height="6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               MinWidth="52" TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </tv:TableViewTemplateColumn.CellTemplate>
                                    </tv:TableViewTemplateColumn>
                                    <tv:TableViewTemplateColumn Header="Memory" Width="2*">
                                        <tv:TableViewTemplateColumn.CellTemplate>
                                            <DataTemplate x:DataType="vm:ResourceRow">
                                                <Grid Margin="8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Minimum="0"
                                                                 Maximum="{Binding MaxMemoryBytes}"
                                                                 Value="{Binding MemoryBytes}"
                                                                 VerticalAlignment="Center" Height="6" />
                                                    <TextBlock Grid.Column="1" Text="{Binding MemoryText}"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                                               MinWidth="72" TextAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </tv:TableViewTemplateColumn.CellTemplate>
                                    </tv:TableViewTemplateColumn>
                                    <tv:TableViewTextColumn Header="Threads" Binding="{Binding Threads}" Width="80" />
                                </tv:TableView.Columns>
                            </tv:TableView>
                        </Grid>
                    </Border>

                    <!-- Environment card: architecture, app dir, plugin roots,
                         extensions. Each sub-section collapses when empty. -->
                    <Border Style="{StaticResource DashboardCardStyle}">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Environment" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Grid ColumnSpacing="12" RowSpacing="2"
                                  Visibility="{Binding Architecture, Converter={StaticResource StringToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Architecture"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Architecture}" />
                            </Grid>
                            <Grid ColumnSpacing="12" RowSpacing="2"
                                  Visibility="{Binding BaseDirectory, Converter={StaticResource StringToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="App directory"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding BaseDirectory}"
                                           Foreground="{Binding BaseDirectory, Converter={StaticResource UrlToBrushConverter}}"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <TextBlock Text="Plugin roots" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding PluginRoots.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding PluginRoots}"
                                          Visibility="{Binding PluginRoots.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}"
                                                   Foreground="{Binding Converter={StaticResource UrlToBrushConverter}}"
                                                   TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Extensions" FontSize="12" Margin="0,8,0,0"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{Binding Extensions.Count, Converter={StaticResource CountToVisibilityConverter}}" />
                            <ItemsControl ItemsSource="{Binding Extensions}"
                                          Visibility="{Binding Extensions.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </muxc:SplitView>
</UserControl>

