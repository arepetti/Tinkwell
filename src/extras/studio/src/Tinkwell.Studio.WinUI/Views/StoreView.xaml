<UserControl
    x:Class="Tinkwell.Studio.Views.StoreView"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tv="using:WinUI.TableView"
    xmlns:svc="using:Tinkwell.Studio.Services"
    xmlns:vm="using:Tinkwell.Studio.ViewModels"
    xmlns:controls="using:Tinkwell.Studio.Controls">

    <Grid>
        <muxc:SplitView IsPaneOpen="{Binding IsDrawerOpen}"
                        PanePlacement="Right"
                        DisplayMode="Inline"
                        OpenPaneLength="460"
                        CompactPaneLength="0">
            <muxc:SplitView.Pane>
                <Border Style="{StaticResource DrawerPanelStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Selected.Key}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding CloseDrawerCommand}"
                                    ToolTipService.ToolTip="Close">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                            </Button>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding OpenEditCommand}"
                                    ToolTipService.ToolTip="Edit">
                                <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding DeleteSelectedCommand}"
                                    ToolTipService.ToolTip="Delete">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Selected.Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:Detail">
                                    <Grid Margin="0,3" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                   Foreground="{Binding ., Converter={StaticResource DetailForegroundConverter}}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- "Value" header row: label + inline spinner that surfaces
                             the lazy `tw store get` fetch (the list view returns the
                             value pre-truncated, so we hydrate on selection). -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <TextBlock Text="Value"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <ProgressRing Width="14" Height="14"
                                          IsActive="True"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding Selected.IsHydrating, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="loading..."
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Selected.IsHydrating, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                        <TextBox Grid.Row="4"
                                 Text="{Binding Selected.Value, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                 MinHeight="100" />
                        <TextBlock Grid.Row="5" Text="Change log"
                                   FontWeight="SemiBold" Margin="0,8,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView Grid.Row="6" ItemsSource="{Binding Selected.ChangeLog}"
                                  FontFamily="Cascadia Code, Consolas, Menlo, monospace"
                                  SelectionMode="None" />
                    </Grid>
                </Border>
            </muxc:SplitView.Pane>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="12"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding OpenNewCommand}"
                                ToolTipService.ToolTip="New entry">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="New" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                ToolTipService.ToolTip="Refresh">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                        <ProgressRing Style="{StaticResource InlineBusyRingStyle}"
                                      Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding Entries.Count}" VerticalAlignment="Center" />
                        <TextBlock Text="entries" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <!-- One Expander per bucket. WinUI.TableView 1.4.1 doesn't
                     support grouping internally so we render a separate
                     TableView per bucket inside an outer ItemsControl;
                     selection is wired up in code-behind to keep a single
                     visual highlight across the multiple tables. -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StoreGroup">
                                <Expander HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="True"
                                          Margin="0,0,0,8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding BucketId}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="(" />
                                                <Run Text="{Binding Entries.Count}" />
                                                <Run Text=")" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Expander.Header>
                                    <tv:TableView ItemsSource="{Binding Entries}"
                                                  SelectionUnit="Row"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  GridLinesVisibility="Horizontal"
                                                  Loaded="OnInnerTableLoaded"
                                                  Unloaded="OnInnerTableUnloaded">
                                        <tv:TableView.Columns>
                                            <!-- Default leading chip: store
                                                 entries don't carry their own
                                                 classification (every row is
                                                 just a key/value pair), so
                                                 every row gets the same
                                                 neutral indicator. -->
                                            <tv:TableViewTemplateColumn Header="" Width="44">
                                                <tv:TableViewTemplateColumn.CellTemplate>
                                                    <DataTemplate x:DataType="vm:StoreEntry">
                                                        <controls:Indicator Margin="12,0"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </tv:TableViewTemplateColumn.CellTemplate>
                                            </tv:TableViewTemplateColumn>
                                            <tv:TableViewTextColumn Header="Namespace" Binding="{Binding Namespace}" Width="160" />
                                            <tv:TableViewTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                                        </tv:TableView.Columns>
                                    </tv:TableView>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </muxc:SplitView>

        <Border Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                Background="#99000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="680" MaxWidth="820"
                    Padding="24"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Store entry" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBox PlaceholderText="key" Text="{Binding EditorKey, Mode=TwoWay}"
                             IsEnabled="{Binding EditorIsNew}" MinHeight="36" />
                    <TextBox PlaceholderText="value (JSON or plain)" Text="{Binding EditorValue, Mode=TwoWay}"
                             AcceptsReturn="True" MinHeight="260"
                             FontFamily="Cascadia Code, Consolas, Menlo, monospace" />
                    <TextBlock Text="{Binding EditorError}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding EditorError, Converter={StaticResource StringToVisibilityConverter}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CloseEditorCommand}" />
                        <Button Content="Save" Style="{ThemeResource AccentButtonStyle}" Command="{Binding SubmitEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
